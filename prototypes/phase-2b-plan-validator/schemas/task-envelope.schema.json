{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jarvis.example.com/schemas/task-envelope.schema.json",
  "title": "Task Envelope",
  "type": "object",
  "properties": {
    "schema_version": { "type": "string" },
    "task_id": { "type": "string", "maxLength": 100 },
    "title": { "type": "string", "maxLength": 200 },
    "request": { "type": "string", "maxLength": 2000 },
    "project_id": { "type": "string", "maxLength": 100 },
    "workspace_roots": {
      "type": "array",
      "items": { "type": "string" },
      "maxItems": 10
    },
    "allowed_tools": {
      "type": "array",
      "items": { "type": "string" },
      "maxItems": 100
    },
    "denied_tools": {
      "type": "array",
      "items": { "type": "string" },
      "maxItems": 100
    },
    "maximum_steps": { "type": "integer", "minimum": 1, "maximum": 50 },
    "maximum_model_retries": { "type": "integer", "minimum": 0, "maximum": 10 },
    "approval_policy_version": { "type": "string" },
    "network_policy": { "type": "string", "enum": ["none", "loopback", "restricted", "all"] }
  },
  "required": ["schema_version", "task_id", "title", "request", "allowed_tools", "maximum_steps", "network_policy"],
  "additionalProperties": false
}
