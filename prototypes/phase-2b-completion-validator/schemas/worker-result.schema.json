{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jarvis.example.com/worker-result.schema.json",
  "title": "Worker Result",
  "type": "object",
  "properties": {
    "schema_version": { "type": "string" },
    "task_id": { "type": "string" },
    "status_claim": { "type": "string" },
    "summary": { "type": "string" },
    "result_type": { "type": "string" },
    "artifact_ids": {
      "type": "array",
      "items": { "type": "string" }
    },
    "criterion_claims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "criterion_id": { "type": "string" },
          "claimed_satisfied": { "type": "boolean" },
          "evidence_ids": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "required": ["criterion_id", "claimed_satisfied"],
        "additionalProperties": false
      }
    },
    "limitations": {
      "type": "array",
      "items": { "type": "string" }
    },
    "errors": {
      "type": "array",
      "items": { "type": "string" }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    },
    "approval_claims": {
      "type": "array",
      "items": { "type": "string" }
    },
    "worker_confidence": { "type": "number", "minimum": 0, "maximum": 1 }
  },
  "required": [
    "schema_version",
    "task_id",
    "status_claim",
    "summary",
    "result_type",
    "artifact_ids",
    "criterion_claims",
    "worker_confidence"
  ],
  "additionalProperties": false
}
