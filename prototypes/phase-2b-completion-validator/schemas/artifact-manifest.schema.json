{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jarvis.example.com/artifact-manifest.schema.json",
  "title": "Artifact Manifest",
  "type": "object",
  "properties": {
    "artifact_id": { "type": "string" },
    "task_id": { "type": "string" },
    "artifact_type": { "type": "string" },
    "format": { "type": "string" },
    "relative_path": { "type": "string" },
    "size_bytes": { "type": "integer", "minimum": 0 },
    "sha256": { "type": "string" },
    "created_by_worker_id": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "content_excerpt": { "type": "string", "maxLength": 1000 },
    "validation_metadata": {
      "type": "object",
      "additionalProperties": true
    },
    "is_temporary": { "type": "boolean", "default": false }
  },
  "required": [
    "artifact_id",
    "task_id",
    "artifact_type",
    "format",
    "relative_path",
    "size_bytes",
    "sha256",
    "created_at"
  ],
  "additionalProperties": false
}
