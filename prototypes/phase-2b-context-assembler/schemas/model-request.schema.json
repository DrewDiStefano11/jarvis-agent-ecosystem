{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jarvis.example.com/schemas/model-request.schema.json",
  "title": "Model Request",
  "type": "object",
  "required": ["schema_version", "request_id", "messages", "request_hash"],
  "properties": {
    "schema_version": { "type": "string" },
    "request_id": { "type": "string" },
    "task_id": { "type": "string" },
    "project_id": { "type": "string" },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["role", "content"],
        "properties": {
          "role": { "type": "string" },
          "content": { "type": "string" }
        }
      }
    },
    "generation": {
      "type": "object",
      "properties": {
        "temperature": { "type": "number" },
        "maximum_output_tokens": { "type": "integer" }
      }
    },
    "context_manifest_id": { "type": "string" },
    "request_hash": { "type": "string" }
  },
  "additionalProperties": false
}
