APP_ENV=development
JARVIS_DATABASE_URL=sqlite:///./data/jarvis.db
JARVIS_DATA_DIRECTORY=./data
JARVIS_SQL_ECHO=false
JARVIS_AUTO_MIGRATE=true
JARVIS_SIMULATOR_AUTO_RESUME=false
JARVIS_OUTBOX_POLL_INTERVAL_MS=250
JARVIS_OUTBOX_MAX_ATTEMPTS=10
JARVIS_CHECKPOINT_EVERY_STEP=true
JARVIS_SANDBOX_ROOT=./data/sandbox
JARVIS_SANDBOX_MAXIMUM_FILE_SIZE=10485760
JARVIS_SANDBOX_ALLOWED_EXTENSIONS=
JARVIS_SANDBOX_RESTRICTED_DIRECTORIES=
JARVIS_SANDBOX_TEMPORARY_DIRECTORY=.sandbox-tmp
JARVIS_SANDBOX_READ_ONLY=false
API_HOST=127.0.0.1
API_PORT=8000
WEB_ORIGIN=http://localhost:5173
SIMULATOR_DELAY_MS=800
SIMULATOR_ACCELERATED=false
